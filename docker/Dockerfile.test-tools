# syntax=docker/dockerfile:1
#
# 每一項檢查都在這份映像裡跑——本機與 CI 皆然。
#
# 它之所以存在，是因為主機不是這個專案的證據。在這個 repo 被搭起來的那台機器上，
# Python 是 3.10、pytest 是 6.2.5，於是 pyproject.toml 的 `pythonpath` 被一個老到
# 不認得這個選項的 pytest 靜默忽略；#56 的 `io` 撞名在那裡顯示的症狀與 3.11 上不同；
# 而 hadolint 只存在於 CI，於是 pipeline 連續六次全紅，本機每次執行卻都報乾淨。
#
# 把「工具不在就中止」改成不再直接通過（fix(ci) 458b221），只是把靜默跳過變成大聲
# 跳過。大聲跳過仍然是一項沒有跑到的檢查。這份檔案才是真正的解法：一個環境，
# 兩個呼叫者。
#
# 獨立成一份 Dockerfile 而不是應用映像裡的一個階段，因為兩者的目標相反——那一份
# 要出貨得越少越好，這一份要帶齊每一支 linter——而應用映像裡的 `-test` 階段會把整條
# 工具鏈拖進應用自己的建置圖裡。

FROM python:3.11-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG HADOLINT_VERSION=2.12.0
ARG ACTIONLINT_VERSION=1.7.7
ARG JUST_VERSION=1.42.4
# 換鏡像的理由與 base 帶 APT_MIRROR_UBUNTU 相同：deb.debian.org 是一個 Fastly 的
# anycast 位址，從開發這個 repo 的網路連不到；而一份只有在 GitHub runner 上建得起來
# 的映像，當不了「所有人都在裡面跑檢查」的那份映像——那正是這個檔案唯一的工作。
# `--build-arg APT_MIRROR=deb.debian.org` 可以換回上游。
#
# 指定這個鏡像，是因為它**同時**有 /debian 與 /debian-security。更近的
# ftp.tw.debian.org 與 free.nchc.org.tw 只有前者，而只改寫主 archive 會讓 security
# 那組仍然指向那台本來就連不到的主機——一次仍然會失敗的 apt update，只是往下挪了一行。
ARG APT_MIRROR="mirror.twds.com.tw"

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# bats：smoke 規格。shellcheck：script/ 底下的每一支 shell 腳本。git：lint_commit
# 要讀歷史，而 pytest 那組測試會操作真實的 repo。
#
# 腳本數量不寫在這裡：能從樹推導出來的數字不另外抄一份（不變式 9）。這一行原本寫
# 「23 shell scripts」，實際上已經是 27 支。
RUN sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bats \
        ca-certificates \
        curl \
        git \
        shellcheck \
    && rm -rf /var/lib/apt/lists/*

# 釘住版本，不用 "latest"：會在你腳下自己變動的 linter 會讓一筆無關的 commit 變紅，
# 而遇到無法解釋的紅燈，人的第一個反應就是不再信任這個閘門。
#
# `just` 裝在這裡，是因為在它之前**整個 justfile 家族沒有任何東西執行過它**：主機沒有
# `just`，這份映像也沒有，於是 `justfile` 的擴充點指向一個被 gitignore 的檔案這件事
# 安靜地成立了不知道多久（#108）。#74 的盤點把 justfile 列為刻意的空格，理由是
# 「薄 wrapper」——那個理由對**接線是否成立**不適用：接線壞掉時，薄不薄都一樣叫不動。
RUN curl -fsSL -o /usr/local/bin/hadolint \
        "https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-Linux-x86_64" \
    && chmod +x /usr/local/bin/hadolint \
    && curl -fsSL "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
        | tar -xz -C /usr/local/bin actionlint \
    && chmod +x /usr/local/bin/actionlint \
    && curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
        | tar -xz -C /usr/local/bin just \
    && chmod +x /usr/local/bin/just

COPY config/pip/requirements-dev.txt /tmp/requirements-dev.txt
COPY config/pip/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements-dev.txt \
    && rm -f /tmp/requirements-dev.txt /tmp/requirements.txt

# 瀏覽器。`web/index.html` 的行內 JS 由 pytest 量不到，所以 T11 的規格用一個真的
# Chromium 打開真的頁面，覆蓋率由 V8 自己算（#97）。
#
# 裝在這裡而不是應用映像的一個 `FROM runtime` 階段——那是原本傾向的做法——理由是
# 本機與 CI 必須跑同一組檢查。這個 repo 最貴的一次教訓正是一項只在 CI 跑得到的
# 檢查（hadolint，連續六次全紅而本機每次都報乾淨）；把 web/ 的門檻放進一個
# `just test` 到不了的階段，等於把那個形狀再做一次。而 index.html 是靜態檔、沒有
# 打包步驟（§3.3），量它根本用不到應用映像。
#
# 實測的三個選項（arm64，本機建置）：
#
#   playwright install --with-deps chromium   444 MB -> 1.94 GB
#   apt-get install chromium                  444 MB -> 1.26 GB
#   headless shell + 手選的 20 個 lib         444 MB -> 980 MB   ← 採用
#
# headless shell 是同一個 V8 與同一套 CDP，少的是桌面那一半（GTK、字型、音訊）
# ——而那一半在一個沒有螢幕的檢查映像裡本來就用不到。
ARG PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
ENV PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH}
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg-query -W > /usr/local/share/config_manager-test-tools-packages.txt \
    && playwright install chromium-headless-shell \
    && chmod -R a+rX "${PLAYWRIGHT_BROWSERS_PATH}"

# 這條 safe.directory 是給 root 那種情況用的。script/test.sh 是以**呼叫端的使用者**
# 而不是 root 來跑這份映像——root 程序寫進 bind mount 會在主機上留下 root 所有的檔案
# ——而那個使用者在這裡沒有家目錄，所以它是用 GIT_CONFIG_* 把 safe.directory 傳進去，
# 並不會讀到這一行。留著是給直接以 root 執行這份映像的人用的。
RUN git config --global --add safe.directory '*'

# script/test.sh 靠這個知道自己已經到了，不可以再往下遞迴一層。
ENV CM_IN_TEST_IMAGE=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /repo
CMD ["./script/test.sh"]
