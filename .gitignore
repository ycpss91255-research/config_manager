.DS_Store
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 衍生產物。
coverage/
htmlcov/
.coverage
# web/index.html 的覆蓋率報告，由 T11 的規格寫出、由 script/coverage_gate.sh 讀。
.coverage-web.json
# 驗收報表與 release notes，由 script/release.sh 寫在目前目錄下再交給 gh。
# 它們是 release 的產物，不是 repo 的內容——權威的那一份在 release 上。
acceptance-v*.txt
release-notes-v*.md
.env

# 操作者自有的覆寫設定。`.local` 字尾標記的是一整族——永不提交，也永不被任何工具
# 覆蓋。
*.local

# Agent 的 worktree。它們是住在這個 repo 裡面的 repo 簽出，所以從 repo 根目錄下
# `git add -A` 會把整棵樹的第二份副本掃進 commit——而那個 diff 大到不會有人細看。
.claude/worktrees/
