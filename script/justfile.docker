# 容器操作。每個 recipe 都轉給 script/ 底下的一支腳本——腳本是實作，這裡只是名字。

# 建置映像（預設照 compose 檔：現場是 runtime）
build *ARGS:
    @{{justfile_directory()}}/script/build.sh {{ARGS}}

# 啟動 backend 與 frontend
run *ARGS:
    @{{justfile_directory()}}/script/run.sh {{ARGS}}

# 進入執行中的服務開 shell（預設：backend）
exec *ARGS:
    @{{justfile_directory()}}/script/exec.sh {{ARGS}}

# 停止服務；config_repo volume 會留著
stop *ARGS:
    @{{justfile_directory()}}/script/stop.sh {{ARGS}}

# 回收本專案的容器與懸空映像
prune *ARGS:
    @{{justfile_directory()}}/script/prune.sh {{ARGS}}

# 備份 config-repo 成一個檔案，放進主機上的資料夾（服務不必停；不含目標檔案）
backup *ARGS:
    @{{justfile_directory()}}/script/backup.sh {{ARGS}}

# 把備份還原成 config-repo（服務要先停、設定庫要是空的）
restore *ARGS:
    @{{justfile_directory()}}/script/restore.sh {{ARGS}}

# 開發用：先疊上 compose.dev.yaml 再做後面的動作，例如 `just docker dev run`、`just docker dev build`
dev VERB *ARGS:
    @COMPOSE_FILE=compose.yaml:compose.dev.yaml {{justfile_directory()}}/script/{{VERB}}.sh {{ARGS}}

# bridge 網路：先疊上 compose.bridge.yaml 再做後面的動作（要先設 CM_HOSTNAME），例如 `just docker bridge run`
bridge VERB *ARGS:
    @COMPOSE_FILE=compose.yaml:compose.bridge.yaml {{justfile_directory()}}/script/{{VERB}}.sh {{ARGS}}
