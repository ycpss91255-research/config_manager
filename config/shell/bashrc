# devel 階段的互動 shell。純粹是方便——這裡的任何東西都不可以變成別的東西的前提，
# 因為 runtime 沒有 bashrc，而它必須表現得一模一樣。

[[ $- == *i* ]] || return

export PATH="${HOME}/.local/bin:${PATH}"
export PYTHONPATH="${APP_ROOT:-/opt/config_manager}/src:${PYTHONPATH:-}"

PS1='\[\e[1;32m\]config_manager\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '

alias ll='ls -alF'
alias t='just test'
